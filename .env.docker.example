# Local Docker platform defaults only (DEV-001).
# Copy to .env.docker for local overrides. Never commit real secrets.
# These values are intentionally weak and local-only. Do not reuse in staging/production.

# PostgreSQL
POSTGRES_USER=educore
POSTGRES_PASSWORD=educore_local_only
POSTGRES_DB=educore
POSTGRES_HOST_PORT=5432

# Redis
REDIS_PASSWORD=educore_local_only
REDIS_HOST_PORT=6379

# Convenience connection strings for future approved wiring tasks only.
# The NestJS API is NOT connected to these services in DEV-001.
# DATABASE_URL=postgresql://educore:educore_local_only@localhost:5432/educore
# REDIS_URL=redis://:educore_local_only@localhost:6379/0
