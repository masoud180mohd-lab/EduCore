# Public API origin for the browser (no trailing slash).
# Nest API defaults to PORT=3000; web app uses 3001.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# WEB-AUTH0 (optional) — show “Ingia na Auth0” on /login when both set.
# Use the same Auth0 domain/client as API Doppler (public values only).
# Callback must be allowlisted: http://localhost:3001/auth/callback
# NEXT_PUBLIC_AUTH0_DOMAIN=dev-xxxxx.us.auth0.com
# NEXT_PUBLIC_AUTH0_CLIENT_ID=
# NEXT_PUBLIC_AUTH0_AUDIENCE=
