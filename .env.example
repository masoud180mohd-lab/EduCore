# Local development defaults only. Do not add real credentials to this file.
NODE_ENV=development

# Optional local database URL for migrate/bootstrap scripts (privileged / DEV-001).
# See docs/engineering/development-environment.md and apps/api/db/README.md.
# DATABASE_URL=postgresql://educore:educore_local_only@127.0.0.1:5432/educore

# Nest runtime membership checks (educore_app ONLY — never migrator/superuser).
# Without these, TenantMembershipChecker stays DenyAll (CI-safe).
# EDUCORE_APP_DATABASE_URL=postgresql://educore_app:educore_app_local_only@127.0.0.1:5432/educore
# EDUCORE_ENABLE_APP_DB=1
# ClickPesa ingest pool (educore_webhook). Required in staging/prod; local default when ENABLE_APP_DB=1.
# EDUCORE_WEBHOOK_DATABASE_URL=postgresql://educore_webhook:educore_webhook_local_only@127.0.0.1:5432/educore
# Platform operations pool (educore_platform). Required for /api/v1/platform/* writes; local default when ENABLE_APP_DB=1.
# EDUCORE_PLATFORM_DATABASE_URL=postgresql://educore_platform:educore_platform_local_only@127.0.0.1:5432/educore

# Local admin seed only (npm run seed:admin). Never commit real credentials.
# Uses educore_platform (not Nest pool). See apps/api/db/seeds/README.md
# SEED_ADMIN_PASS=ChangeMe-Local-Only-1
# SEED_ADMIN_EMAIL=admin@educore.local
# SEED_TENANT_CODE=demo-school
# SEED_ADMIN_RESET=1

# Payments provider (PAY-001…003). Default fake — never put real ClickPesa secrets in git.
# PAYMENT_PROVIDER=fake
# PAYMENT_PROVIDER=clickpesa
# CLICKPESA_BASE_URL=https://api.clickpesa.com/third-parties
# CLICKPESA_CLIENT_ID=
# CLICKPESA_API_KEY=
# CLICKPESA_CHECKSUM_KEY=

# SMS provider (COMMS-001…005). Default fake — never put real Beem secrets in git.
# SMS_PROVIDER=fake
# SMS_PROVIDER=beem
# BEEM_BASE_URL=https://apisms.beem.africa
# BEEM_API_KEY=
# BEEM_SECRET_KEY=
# BEEM_SOURCE_ADDR=
# BEEM_WEBHOOK_SECRET=
# SMS_DAILY_CAP_PER_TENANT=500
# Outbox worker (COMMS-006): async SMS sending with retry/backoff + dead-letter.
# Set false when running dedicated worker instances (single in-process worker by default).
# SMS_OUTBOX_WORKER_ENABLED=true
# SMS_OUTBOX_POLL_MS=5000
# SMS_OUTBOX_BATCH=10
# SMS_OUTBOX_CLAIM_SECONDS=120
# SMS_OUTBOX_MAX_ATTEMPTS=5
# Privileged MFA (MFA-001…005). Soft enforce default; never commit real encryption keys.
# MFA_ENFORCE=soft
# MFA_ENFORCE=hard
# 32-byte key as base64 or 64-char hex:
# MFA_TOTP_ENCRYPTION_KEY=

# Hosted IdP (ID-002 / ID-003). Default local — assertion login stays disabled.
# AUTH_IDP_PROVIDER=local
# AUTH_IDP_PROVIDER=auth0
# AUTH0_DOMAIN=your-tenant.eu.auth0.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_AUDIENCE=
# Staging/lab only — first-link Auth0 email when email_verified=false (default off):
# AUTH0_ALLOW_UNVERIFIED_EMAIL_LINK=1

# AI Gateway (EPIC-AI-01 / AI-002…006). Fake default — never commit OpenAI keys.
# AI_PLATFORM_ENABLED=true
# AI_PROVIDER=fake
# AI_PROVIDER=disabled
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_MODEL=gpt-4o-mini
# AI_DAILY_CAP_PER_TENANT=100
# AI_BYPASS_DAILY_CAP=true
# AI_FEATURE_DISABLED=
